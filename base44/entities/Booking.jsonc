{
  "name": "Booking",
  "type": "object",
  "properties": {
    "lot_id": {
      "type": "string",
      "title": "Lot ID"
    },
    "lot_name": {
      "type": "string",
      "title": "Lot Name"
    },
    "lot_address": {
      "type": "string",
      "title": "Lot Address"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "title": "End Time"
    },
    "duration_hours": {
      "type": "number",
      "title": "Duration Hours"
    },
    "total_price": {
      "type": "number",
      "title": "Total Price"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "confirmed",
      "title": "Status"
    },
    "spot_number": {
      "type": "number",
      "title": "Spot Number"
    },
    "payment_id": {
      "type": "string",
      "title": "Payment ID"
    }
  },
  "required": [
    "lot_id",
    "lot_name",
    "start_time",
    "end_time",
    "duration_hours",
    "total_price",
    "status"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}